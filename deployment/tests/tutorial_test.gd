extends SceneTree

const Tutorial = preload("res://scenes/balatro/scripts/tutorial_page.gd")
const Flow = preload("res://scenes/balatro/scripts/tutorial_flow.gd")

func _initialize() -> void:
	run.call_deferred()

func run() -> void:
	root.size = Vector2i(1800, 900)
	var page := Tutorial.new()
	root.add_child(page)
	await process_frame
	assert(page.table_background.get_rect().size == page.size, "Table must fill the screen, not a tutorial sidebar")
	assert(page.table_background.stretch_mode == TextureRect.STRETCH_KEEP_ASPECT_COVERED)
	var outcomes: Array = []
	page.finished.connect(func(completed): outcomes.append(completed))
	assert(page.rules.hand_size == 2 and page.rules.players[0].hand == [30, 0])
	assert(page.board.get_child_count() == 0 and page.hand_buttons.is_empty())
	assert(page.dialogue.position.x > page.portrait.position.x + page.portrait.size.x)
	assert(page.text_label.text == "BISCA è un battle royale di carte.\nSe perdi tutte le vite, sei fuori.\nRimani l’ultimo in gioco per vincere!")
	page.advance()
	assert(page.step == Tutorial.Step.TAKE and page.progress.get_parent() == page.dialogue)
	assert(page.text_label.text == "In ogni giro, tutti giocano una carta.\nLa carta dal valore maggiore conquista la presa.")
	if "--snapshot" in OS.get_cmdline_user_args(): await snapshot("take")
	page.advance()
	assert(page.step == Tutorial.Step.VALUES)
	if "--snapshot" in OS.get_cmdline_user_args(): await snapshot("suits")
	page.advance()
	assert(page.step == Tutorial.Step.STRATEGY)
	page.advance()
	assert(page.step == Tutorial.Step.BID)
	assert(page.hand_buttons.size() == 2)
	page.advance()
	page._bid(0)
	assert(page.step == Tutorial.Step.BID, "Dialog cannot skip the required action")
	page._bid(1)
	assert(page.rules.phase == "play")
	assert(page.rules.players[0].bid == 1)
	assert(page.step == Tutorial.Step.TARGET)
	assert(not page.hand_buttons[0].disabled and page.hand_buttons[1].disabled)
	page.hand_buttons[0].pressed.emit()
	assert(page.target_action == 1)
	page._joker_high()
	assert(page.rules.last_winner == 0 and page.rules.players[0].taken == 1)
	page.advance()
	assert(page.step == Tutorial.Step.TARGET and page.target_action == 2)
	page.hand_buttons[0].pressed.emit()
	assert(page.target_action == 3)
	page.advance()
	assert(page.step == Tutorial.Step.LIVES)
	assert(page.rules.players[0].lives == 3 and page.rules.players[1].lives == 2)
	if "--snapshot" in OS.get_cmdline_user_args(): await snapshot("lives")
	page.advance()
	page.advance()
	assert(page.step == Tutorial.Step.BLIND)
	assert(page.rules.view_for(0).players[0].hand == [-1])
	assert(page.rules.view_for(0).players[1].hand == [29])
	assert(page.hand_buttons[0].get_child(0).texture == root.get_node("GameSettings").back_texture())
	if "--snapshot" in OS.get_cmdline_user_args(): await snapshot("blind")
	page._bid(1)
	assert(page.step == Tutorial.Step.BLIND)
	page._bid(0)
	assert(page.step == Tutorial.Step.LOOP)
	assert(page.rules.players[0].taken == 0 and page.rules.players[0].lives == 3)
	page.advance()
	assert(outcomes == [true])
	page.queue_free()
	await process_frame
	var flow := Flow.new()
	flow.save_path = "/tmp/bisca-tutorial-test-%s.cfg" % Time.get_ticks_usec()
	root.add_child(flow)
	assert(not Flow.was_offered(flow.save_path))
	flow.start()
	assert(Flow.was_offered(flow.save_path))
	flow.tutorial.finished.emit(false)
	await process_frame
	assert(not is_instance_valid(flow))
	var offered := Flow.new()
	offered.save_path = "/tmp/bisca-tutorial-offer-test-%s.cfg" % Time.get_ticks_usec()
	var path := offered.save_path
	root.add_child(offered)
	offered.offer()
	var dialog := offered.get_child(1)
	assert(dialog.get_cancel_button().text == "SALTA")
	dialog.canceled.emit()
	await process_frame
	assert(not is_instance_valid(offered) and Flow.was_offered(path))
	var complete := Flow.new()
	complete.save_path = path
	root.add_child(complete)
	complete.start()
	complete.tutorial.finished.emit(true)
	await process_frame
	var config := ConfigFile.new()
	config.load(path)
	assert(config.get_value("tutorial", "completed", false))
	print("PASS: tutorial actions, real rules, joker, life loss, blind round, completion, skip and onboarding persistence")
	quit()

func snapshot(label: String) -> void:
	await create_timer(0.15).timeout
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("/tmp/bisca-tutorial-" + label + ".png")
